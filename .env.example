# ============================================================================
# COMPUTECH environment configuration
# Copy this file to `.env.local` for local development.
# Never commit `.env.local`, and never expose server-only keys to the browser.
# ============================================================================

# ----------------------------------------------------------------------------
# Public site
# ----------------------------------------------------------------------------
# Canonical origin used for metadata, sitemap, auth redirects and payment
# callback URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Store contact details shown in the footer and help pages. These can also be
# overridden from Admin > Settings (stored in public.site_settings).
NEXT_PUBLIC_STORE_EMAIL=hello@computech.example
NEXT_PUBLIC_STORE_WHATSAPP=6281234567890

# ----------------------------------------------------------------------------
# Supabase (required)
# ----------------------------------------------------------------------------
# Project URL and anon/public key are safe for the browser. RLS still applies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only. Used by payment webhooks, inventory RPCs and other trusted
# operations. NEVER prefix this with NEXT_PUBLIC_ and never expose it client-side.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ----------------------------------------------------------------------------
# Payments
# ----------------------------------------------------------------------------
# manual   = bank transfer verified by staff (default, works without keys)
# midtrans = Midtrans Snap sandbox/production
# xendit   = Xendit Invoice sandbox/production
PAYMENT_PROVIDER=manual

# Midtrans (server key must stay server-only)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Xendit
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_IS_PRODUCTION=false

# ----------------------------------------------------------------------------
# Shipping
# ----------------------------------------------------------------------------
# manual     = use the shipping_methods table maintained in Admin > Settings
# rajaongkir = live quotes from RajaOngkir; falls back to manual when unavailable
SHIPPING_PROVIDER=manual
RAJAONGKIR_API_KEY=
RAJAONGKIR_ORIGIN_CITY_ID=
